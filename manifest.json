{
  "manifest_version": 3,
  "name": "PRism",
  "description": "Monitor Apache Flink pull requests with CI status — built for open source contributors",
  "version": "1.0.3",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/*"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flink PR Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
